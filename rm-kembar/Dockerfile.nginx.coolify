# ============================================================
# Dockerfile.nginx.coolify — ARM64 production nginx image
# Bakes in the nginx config + compiled Vite assets so
# no bind mounts are needed on the Coolify server.
# ============================================================

# Stage 1: Build frontend assets (Vite)
FROM --platform=linux/arm64 node:20-alpine AS node-builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY vite.config.js ./
COPY resources/ ./resources/
COPY public/ ./public/

RUN npm run build

# Stage 2: Nginx with config + built assets baked in
FROM --platform=linux/arm64 nginx:alpine

# Bake nginx config — no volume mount required
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy compiled Vite assets so nginx can serve them statically
COPY --from=node-builder /app/public /var/www/public

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
